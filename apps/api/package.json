{
  "name": "@tech-radio/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/http/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "ingest": "tsx --env-file-if-exists=../../.env src/ingest/ingest.ts",
    "index": "tsx --env-file-if-exists=../../.env src/index/index.ts",
    "show:build": "tsx --env-file-if-exists=../../.env src/show/build-show.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "chromadb": "^3.5.0",
    "hono": "^4.6.13",
    "kokoro-js": "^1.2.1",
    "openai": "^4.73.0",
    "rss-parser": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
